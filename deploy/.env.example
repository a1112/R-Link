R_LINK_API_TOKEN=replace-with-a-long-random-service-key
R_LINK_WEB_BIND=127.0.0.1
R_LINK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
R_LINK_FRP_TOKEN=
R_LINK_CLOUDFLARE_TOKEN=
R_LINK_ACME_STAGING=false
# 自建 NetBird 管理服务的 HTTPS 根地址和服务用户 PAT；留空则组网页显示未配置。
R_LINK_NETBIRD_URL=
R_LINK_NETBIRD_TOKEN=
# Clash 控制器地址和密钥通过管理页面保存；独立内核需另行提供 Linux binaries/mihomo。
# Compose 使用 /opt/rlink/bin/mihomo；本机启动可设置 R_LINK_MIHOMO_BINARY 为实际绝对路径。
# 原生 Linux 网关 QoS 需 R_LINK_QOS_ENABLED=true、iproute2 和 NET_ADMIN 权限。
# 默认 Compose 不获得主机网络权限；可选覆盖文件和部署说明见 docs/device-qos-20261011.md。
