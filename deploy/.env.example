R_LINK_API_TOKEN=replace-with-a-long-random-service-key
R_LINK_WEB_BIND=127.0.0.1
R_LINK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,tauri://localhost,http://tauri.localhost
R_LINK_FRP_TOKEN=
R_LINK_CLOUDFLARE_TOKEN=
R_LINK_ACME_STAGING=false
# 自建 NetBird 管理服务的 HTTPS 根地址和服务用户 PAT；留空则组网页显示未配置。
R_LINK_NETBIRD_URL=
R_LINK_NETBIRD_TOKEN=
# 自研 R-Link 信令/密文中转公开地址；客户端只信任同源 HTTPS/WSS。
R_LINK_FABRIC_PUBLIC_URL=https://175.178.16.90/r-link
R_LINK_FABRIC_ADDRESS_POOL=10.253.199.0/24
R_LINK_FABRIC_STUN_SERVERS=stun:175.178.16.90:51821
# 可选覆盖私有 SQLite 文件路径；文件含机器凭据哈希和成对认证材料。
# R_LINK_FABRIC_DB=/private/data/fabric.sqlite3
# 自动同步间隔（秒，0 为手动）；组网观测超过过期秒数则显示未知。
R_LINK_DEVICE_SYNC_INTERVAL=60
R_LINK_DEVICE_STALE_SECONDS=180

# 多用户登录：独立 Keycloak/OIDC confidential client，不能使用 R-Auth Cookie 作为 R-Link 身份。
# 启用后任何回环/桌面访问都须登录；服务密钥仅用于受控自动化。
R_LINK_AUTH_MODE=local
R_LINK_PUBLIC_URL=https://175.178.16.90/r-link
R_LINK_OIDC_ISSUER=
R_LINK_OIDC_CLIENT_ID=
R_LINK_OIDC_CLIENT_SECRET=
# 精确的可信 issuer 下 subject；留空则所有新用户待审批，不会自动抢占管理员。
R_LINK_BOOTSTRAP_ADMIN_SUBJECT=
R_LINK_SESSION_SECONDS=28800
# 可选独立高熵登录事务加密密钥；留空时由 client secret 派生，旋转会使在途登录失效。
R_LINK_AUTH_FLOW_SECRET=
