# Run ./init.sh once. This file contains no credentials; .env is private.
R_LINK_API_TOKEN=
R_LINK_IMAGE_TAG=0.1.0-nas.20261003
R_LINK_SOURCE_COMMIT=source-checkout
R_LINK_WEB_BIND=0.0.0.0
R_LINK_WEB_PORT=8080
R_LINK_VOLUME_PREFIX=rlink-nas
# Keep both desktop origins; append the actual NAS browser/HTTPS origins.
R_LINK_CORS_ORIGINS=http://localhost:8080,tauri://localhost,http://tauri.localhost
R_LINK_RFILE_URL=http://host.docker.internal:18080
R_LINK_RFILE_BRIDGE_URL=http://host.docker.internal:18100
R_LINK_RFILE_INTERVAL=30
# Files remain disabled until the R-File owner explicitly grants a scope/token.
R_LINK_RFILE_ROOT=
R_LINK_RFILE_SESSION_TOKEN=
R_LINK_RFILE_TOKEN=
R_LINK_RFILE_CA_CERT=
# Optional independent OIDC login; requires an HTTPS reverse proxy and a dedicated confidential client.
R_LINK_AUTH_MODE=local
R_LINK_PUBLIC_URL=
R_LINK_OIDC_ISSUER=
R_LINK_OIDC_CLIENT_ID=
R_LINK_OIDC_CLIENT_SECRET=
R_LINK_BOOTSTRAP_ADMIN_SUBJECT=
R_LINK_SESSION_SECONDS=28800
R_LINK_AUTH_FLOW_SECRET=
# Native encrypted fabric signaling/relay; run the separate Agent STUN service on UDP 51821.
R_LINK_FABRIC_PUBLIC_URL=
R_LINK_FABRIC_ADDRESS_POOL=10.253.199.0/24
R_LINK_FABRIC_STUN_SERVERS=
