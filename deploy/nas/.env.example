# Run ./init.sh once. This file contains no credentials; .env is private.
R_LINK_API_TOKEN=
R_LINK_IMAGE_TAG=0.1.0-nas.20261003
R_LINK_SOURCE_COMMIT=source-checkout
R_LINK_WEB_BIND=0.0.0.0
R_LINK_WEB_PORT=8080
R_LINK_VOLUME_PREFIX=rlink-nas
# Add the actual NAS browser/HTTPS origins, comma-separated.
R_LINK_CORS_ORIGINS=http://localhost:8080
R_LINK_RFILE_URL=http://host.docker.internal:18080
R_LINK_RFILE_BRIDGE_URL=http://host.docker.internal:18100
R_LINK_RFILE_INTERVAL=30
# Files remain disabled until the R-File owner explicitly grants a scope/token.
R_LINK_RFILE_ROOT=
R_LINK_RFILE_SESSION_TOKEN=
R_LINK_RFILE_TOKEN=
R_LINK_RFILE_CA_CERT=
