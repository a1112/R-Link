FROM node:22-alpine AS build
WORKDIR /app
COPY apps/r-link-web/package.json apps/r-link-web/package-lock.json ./
RUN npm ci
COPY apps/r-link-web/src ./src
COPY apps/r-link-web/index.html apps/r-link-web/vite.config.ts apps/r-link-web/tsconfig.json apps/r-link-web/tsconfig.node.json ./
RUN npm run build
FROM nginx:stable-alpine
ARG R_LINK_SOURCE_COMMIT=source-checkout
LABEL org.opencontainers.image.revision=$R_LINK_SOURCE_COMMIT
COPY deploy/nas/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1/health
